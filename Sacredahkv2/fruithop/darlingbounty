-- Función constructora de los 3 botones
local function createButton(scriptName, position)
    local Button = Instance.new("TextButton")
    Button.Parent = Frame
    Button.Size = UDim2.new(0, 140, 0, 32)
    Button.Position = position
    Button.BackgroundColor3 = Color3.fromRGB(28, 28, 33)
    Button.Font = Enum.Font.PermanentMarker
    Button.Text = scriptName
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.TextSize = 13
    Button.BorderSizePixel = 0
    Button.AutoButtonColor = false

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 8)
    BtnCorner.Parent = Button

    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Color = Color3.fromRGB(65, 65, 80)
    BtnStroke.Thickness = 1
    BtnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    BtnStroke.Parent = Button

    Button.MouseEnter:Connect(function()
        TweenService:Create(Button, TweenInfo.new(0.18), {BackgroundColor3 = Color3.fromRGB(48, 48, 58)}):Play()
        TweenService:Create(BtnStroke, TweenInfo.new(0.18), {Color = Color3.fromRGB(120, 120, 160)}):Play()
    end)
    Button.MouseLeave:Connect(function()
        TweenService:Create(Button, TweenInfo.new(0.18), {BackgroundColor3 = Color3.fromRGB(28, 28, 33)}):Play()
        TweenService:Create(BtnStroke, TweenInfo.new(0.18), {Color = Color3.fromRGB(65, 65, 80)}):Play()
    end)

    -- Al hacer clic, simplemente corre el loadstring seleccionado
    Button.MouseButton1Click:Connect(function()
        if SCRIPTS[scriptName] then
            task.spawn(SCRIPTS[scriptName])
        end
    end)

    return Button
end

