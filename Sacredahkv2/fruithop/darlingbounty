local Players = game:GetService("Players")

local function getSafeGuiParent()
    if gethui then
        return gethui()
    elseif CoreGui:FindFirstChild("RobloxGui") then
        return CoreGui
    else
        return Players.LocalPlayer:WaitForChild("PlayerGui")
    end
end

-- Limpiar si ya estaba abierta antes
